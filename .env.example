# ==============================================================================
# DEFENSE PERSONNEL STRESS & WELFARE MONITORING SYSTEM - ENVIRONMENT TEMPLATE
# Copy to .env and configure local secret parameters
# ==============================================================================

PROJECT_NAME="Personnel Stress & Welfare Monitoring System API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Security & JWT Tokenization (Generate a strong 256-bit secret for production)
SECRET_KEY="replace-with-secure-random-token"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Google Gemini AI Clinical Assessment Engine
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-1.5-flash"

# Database Configuration (SQLite for local / PostgreSQL for production)
DATABASE_URL="sqlite:///./hrms.db"

# Redis
REDIS_URL="redis://localhost:6379/0"

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:3001","http://127.0.0.1:3001","http://localhost:5173","*"]
